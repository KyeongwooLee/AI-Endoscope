{
  "cli_version": "codex-cli 0.167.0-alpha.4.1",
  "command_template": [
    "codex",
    "exec",
    "--ignore-user-config",
    "--ephemeral",
    "--skip-git-repo-check",
    "-C",
    "/tmp/errorprobe-gpt-readonly",
    "-s",
    "read-only",
    "-m",
    "gpt-6-astra",
    "-c",
    "model_reasoning_effort=\"medium\"",
    "-c",
    "web_search=\"disabled\"",
    "--json",
    "--disable",
    "apps",
    "--disable",
    "plugins",
    "--disable",
    "hooks",
    "--disable",
    "shell_tool",
    "--disable",
    "unified_exec",
    "--disable",
    "multi_agent",
    "--disable",
    "browser_use",
    "--disable",
    "computer_use",
    "--disable",
    "image_generation",
    "--disable",
    "view_image",
    "--enable",
    "omit_skill_descriptions",
    "--enable",
    "skip_host_skill_discovery"
  ],
  "snapshot_version": "not exposed"
}